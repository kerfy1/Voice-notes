# ============ ОБЯЗАТЕЛЬНЫЕ ============

# --- Telegram --- (@BotFather → /newbot)
TELEGRAM_BOT_TOKEN=

# --- OpenRouter (Whisper + Claude) --- https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- Админы ---
# ID через запятую. Полный доступ: Notion, без лимитов, админ-панель (/admin).
# Свой ID узнать у @userinfobot. БЕЗ ЭТОГО НЕ БУДЕТ РАБОТАТЬ NOTION.
ADMIN_IDS=

# ============ NOTION (только для админов) ============
# Если не заполнить — бот работает, но карточки в Notion не создаются.
NOTION_TOKEN=
NOTION_DATABASE_ID=

# Имена колонок в базе Notion
NOTION_PROP_TITLE=Назва ідеї
NOTION_PROP_ESSENCE=Суть
NOTION_PROP_DATE=Дата
NOTION_PROP_TAG=Тег

# ============ ЛИМИТЫ обычных пользователей ============
# Скользящее окно 7 дней. Срабатывает то, что кончится раньше: штуки ИЛИ объём.
FREE_VOICE_COUNT=5
FREE_VOICE_MINUTES=31
FREE_TEXT_COUNT=5
FREE_TEXT_CHARS=25000

# Потолок на ОДНО сообщение
FREE_MAX_TEXT_LENGTH=5000
FREE_MAX_VOICE_MINUTES=15

# Длина выжимки для обычных пользователей (влезает в одно сообщение TG)
FREE_SUMMARY_CHARS=1200

# ============ МОДЕЛИ ============
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
WHISPER_MODEL=openai/whisper-1
MAX_OUTPUT_TOKENS=4000

# ============ ПРОЧЕЕ ============
# Язык: пусто → спрашивать кнопками. Или зафиксировать: ru | uk | auto
DEFAULT_LANG=

# Минимальная длина текста для конспекта
MIN_TEXT_LENGTH=100

# Нарезка длинных аудио
CHUNK_SECONDS=300
NO_SPLIT_UNDER=420
MAX_AUDIO_SECONDS=7200

# Пути к ffmpeg, если не в PATH
# FFMPEG_BIN=/usr/bin/ffmpeg
# FFPROBE_BIN=/usr/bin/ffprobe
